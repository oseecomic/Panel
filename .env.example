# Public Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secrets: never use NEXT_PUBLIC_ for these
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Pterodactyl Application API (server-side only)
PTERO_PANEL_URL=https://panel.example.com
PTERO_APPLICATION_API_KEY=ptla_REPLACE_ME
PTERO_DEFAULT_EGG_ID=1
PTERO_DEFAULT_NEST_ID=1
PTERO_DEFAULT_LOCATION_ID=1
PTERO_DEFAULT_ALLOCATION_ID=1
ADMIN_ACTION_SECRET=replace-with-another-long-random-secret
PTERO_DEFAULT_DOCKER_IMAGE=ghcr.io/parkervcp/yolks:java_21
PTERO_DEFAULT_STARTUP=java -Xms128M -Xmx{{SERVER_MEMORY}}M -jar {{SERVER_JARFILE}}
PTERO_DEFAULT_ENV_JARFILE=server.jar
PTERO_DEFAULT_ENV_SERVER_JARFILE=server.jar

# Optional Midtrans Snap integration. Leave blank to use manual QRIS proof review.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
